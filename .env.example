# Photoshop MCP settings. Copy to .env in the repo root (or set in your MCP client's "env" block, which wins).
# Transport for MCP clients: stdio (Claude Desktop, VS Code, Cursor) or http (ChatGPT via a tunnel, remote clients)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# Required for http transport when the host is not loopback. Generate: pwsh scripts/new-token.ps1
MCP_AUTH_TOKEN=
# Alternative for connector UIs that cannot send headers: serve at /mcp/<secret> (>= 24 URL-safe chars)
MCP_SECRET_PATH=

# Photoshop bridge: auto (COM on Windows, AppleScript on macOS), com, applescript, or mock (tests/demos, no Photoshop)
PHOTOSHOP_ADAPTER=auto
# Per-call script timeout, and the longer timeout for background jobs (large designs, batch exports)
PHOTOSHOP_TIMEOUT_MS=60000
PHOTOSHOP_JOB_TIMEOUT_MS=900000
# Launch Photoshop on the first tool call if it is not running
PHOTOSHOP_AUTO_LAUNCH=true

# Semicolon-separated directories the server may read/write. Defaults to ./output and ~/Documents/PhotoshopMCP
ALLOWED_PATHS=
# Max files per batch operation
MAX_BATCH_FILES=200

# Image search & downloads (search_* tools, download_image, import_image_to_photoshop, place_image/import_image with url)
# Asset library folder (relative paths resolve against the first allowed path; default: <first allowed path>/assets)
ASSETS_DIR=
# Optional provider keys (Openverse and Wikimedia Commons need none)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Google Images (results have UNVERIFIED licences). SerpApi is preferred; the Custom Search JSON API shuts down on 2027-01-01.
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
DOWNLOAD_RETRIES=2
MAX_IMAGE_DIMENSION=30000
MAX_IMAGE_MEGAPIXELS=200
IMAGE_SEARCH_TIMEOUT_MS=15000
# Max size of one downloaded image in MB
MAX_DOWNLOAD_MB=50
DOWNLOAD_TIMEOUT_MS=30000
# Allow downloads from localhost / private network addresses (off by default to prevent SSRF)
ALLOW_PRIVATE_DOWNLOADS=false

LOG_LEVEL=info
LOG_DIR=logs

# Optional external AI providers (never committed; only used when set)
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
REMOVE_BG_API_KEY=
