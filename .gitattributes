# Normalize text to LF in the repository; check out with the platform's default.
* text=auto eol=lf

# Shell and AppleScript run on macOS / via curl | sh: always LF.
*.sh text eol=lf
*.applescript text eol=lf
# Windows PowerShell 5.1 and cmd need CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ai binary
*.pdf binary
*.eps binary
*.zip binary
*.ico binary
